{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core events and opening mail drafts and video links",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "mailto:*" }, { "url": "https://*" }, { "url": "x-apple.systempreferences:*" }]
    }
  ]
}
